do
    local AG = Tabs.Visuals:AddLeftGroupbox("My Avatar", "user")

    local AvatarSettings = {
        Selected = "Korblox",
        Korblox  = false,
        Headless = false,
    }

    local Saved = {
        Headless = nil,   -- { HeadTransparency, Decals = {[Decal] = Transparency} }
        Korblox  = nil,   -- { Upper = {MeshId, TextureID, Mesh}, Lower = {MeshId, Transparency}, Foot = {Transparency}, R6Mesh = {Mesh} }
    }

    local function GetRigType(char)
        if not char then return nil end
        if char:FindFirstChild("Right Leg") then return "R6" end
        if char:FindFirstChild("RightUpperLeg") then return "R15" end
        return nil
    end

    -- Headless 適用
    local function ApplyHeadless(char)
        if not char then return end
        local head = char:FindFirstChild("Head")
        if not head then return end

        if not Saved.Headless then
            local decals = {}
            for _, v in ipairs(head:GetChildren()) do
                if v:IsA("Decal") then
                    decals[v] = v.Transparency
                end
            end
            Saved.Headless = {
                HeadTransparency = head.Transparency,
                Decals = decals,
            }
        end

        head.Transparency = 1
        for _, v in ipairs(head:GetChildren()) do
            if v:IsA("Decal") then
                v.Transparency = 1
            end
        end
    end

    -- Headless 解除
    local function RemoveHeadless(char)
        if not char then return end
        local head = char:FindFirstChild("Head")
        if not head then return end

        if Saved.Headless then
            head.Transparency = Saved.Headless.HeadTransparency or 0
            for decal, trans in pairs(Saved.Headless.Decals) do
                if decal and decal.Parent then
                    decal.Transparency = trans
                end
            end
        else
            head.Transparency = 0
            for _, v in ipairs(head:GetChildren()) do
                if v:IsA("Decal") then
                    v.Transparency = 0
                end
            end
        end
        Saved.Headless = nil
    end

    -- Korblox 適用
    local function ApplyKorbloxRight(char)
        if not char then return end
        local rig = GetRigType(char)

        if rig == "R15" then
            local rightUpper = char:FindFirstChild("RightUpperLeg")
            local rightLower = char:FindFirstChild("RightLowerLeg")
            local rightFoot  = char:FindFirstChild("RightFoot")

            if not Saved.Korblox then
                local upperMesh = rightUpper and (rightUpper:FindFirstChildOfClass("SpecialMesh") or rightUpper:FindFirstChildOfClass("FileMesh"))
                Saved.Korblox = {
                    Upper = rightUpper and {
                        MeshId = rightUpper.MeshId,
                        TextureID = rightUpper.TextureID,
                        Mesh = upperMesh,
                        MeshId2 = upperMesh and upperMesh.MeshId,
                        TextureId2 = upperMesh and upperMesh.TextureId,
                    } or nil,
                    Lower = rightLower and {
                        MeshId = rightLower.MeshId,
                        Transparency = rightLower.Transparency,
                    } or nil,
                    Foot = rightFoot and {
                        Transparency = rightFoot.Transparency,
                    } or nil,
                }
            end

            if rightUpper then
                rightUpper.MeshId = "http://www.roblox.com/asset/?id=902942096"
                rightUpper.TextureID = "http://roblox.com/asset/?id=902843398"
            end
            if rightLower then
                rightLower.MeshId = "http://www.roblox.com/asset/?id=902942093"
                rightLower.Transparency = 1
            end
            if rightFoot then
                rightFoot.Transparency = 1
            end

            if rightUpper then
                local mesh = rightUpper:FindFirstChildOfClass("SpecialMesh") or rightUpper:FindFirstChildOfClass("FileMesh")
                if mesh then
                    mesh.Offset = Vector3.new(0, 0.45, 0)
                end
            end

        elseif rig == "R6" then
            local rightLeg = char:FindFirstChild("Right Leg")
            if rightLeg then
                local mesh = rightLeg:FindFirstChildOfClass("SpecialMesh")
                if not mesh then
                    mesh = Instance.new("SpecialMesh")
                    mesh.Parent = rightLeg
                end
                if not Saved.Korblox then
                    Saved.Korblox = {
                        R6Mesh = {
                            MeshId = mesh.MeshId,
                            TextureId = mesh.TextureId,
                            Scale = mesh.Scale,
                            Offset = mesh.Offset,
                        }
                    }
                end
                mesh.MeshId = "http://www.roblox.com/asset/?id=902942096"
                mesh.TextureId = "http://roblox.com/asset/?id=902843398"
                mesh.Scale = Vector3.new(1, 1, 1)
                mesh.Offset = Vector3.new(0, 0.55, 0)
            end
        end
    end

    -- Korblox 解除
    local function RemoveKorbloxRight(char)
        if not char then return end
        local rig = GetRigType(char)

        if rig == "R15" then
            local rightUpper = char:FindFirstChild("RightUpperLeg")
            local rightLower = char:FindFirstChild("RightLowerLeg")
            local rightFoot  = char:FindFirstChild("RightFoot")

            if Saved.Korblox and Saved.Korblox.Upper then
                if rightUpper then
                    rightUpper.MeshId = Saved.Korblox.Upper.MeshId or ""
                    rightUpper.TextureID = Saved.Korblox.Upper.TextureID or ""
                    local mesh = rightUpper:FindFirstChildOfClass("SpecialMesh") or rightUpper:FindFirstChildOfClass("FileMesh")
                    if mesh then
                        if Saved.Korblox.Upper.MeshId2 ~= nil then
                            mesh.MeshId = Saved.Korblox.Upper.MeshId2
                        end
                        if Saved.Korblox.Upper.TextureId2 ~= nil then
                            mesh.TextureId = Saved.Korblox.Upper.TextureId2
                        end
                    end
                end
            end
            if Saved.Korblox and Saved.Korblox.Lower then
                if rightLower then
                    rightLower.MeshId = Saved.Korblox.Lower.MeshId or ""
                    rightLower.Transparency = Saved.Korblox.Lower.Transparency or 0
                end
            end
            if Saved.Korblox and Saved.Korblox.Foot then
                if rightFoot then
                    rightFoot.Transparency = Saved.Korblox.Foot.Transparency or 0
                end
            end

        elseif rig == "R6" then
            local rightLeg = char:FindFirstChild("Right Leg")
            if rightLeg then
                local mesh = rightLeg:FindFirstChildOfClass("SpecialMesh")
                if mesh and Saved.Korblox and Saved.Korblox.R6Mesh then
                    mesh.MeshId = Saved.Korblox.R6Mesh.MeshId or ""
                    mesh.TextureId = Saved.Korblox.R6Mesh.TextureId or ""
                    mesh.Scale = Saved.Korblox.R6Mesh.Scale or Vector3.new(1, 1, 1)
                    mesh.Offset = Saved.Korblox.R6Mesh.Offset or Vector3.new(0, 0, 0)
                end
            end
        end
        Saved.Korblox = nil
    end

    local function ApplySelected(char)
        if not char then return end

        if AvatarSettings.Selected == "Korblox" then
            if AvatarSettings.Korblox then
                ApplyKorbloxRight(char)
            else
                RemoveKorbloxRight(char)
            end

        elseif AvatarSettings.Selected == "Headless" then
            if AvatarSettings.Headless then
                ApplyHeadless(char)
            else
                RemoveHeadless(char)
            end
        end
    end

    AG:AddDropdown("AvatarSelect", {
        Text = "Avatar Select",
        Values = { "Korblox", "Headless" },
        Default = "Korblox",
        Multi = false,
        Callback = function(Value)
            AvatarSettings.Selected = Value
            ApplySelected(LocalPlayer.Character)
        end,
    })

    AG:AddToggle("AvatarEnable", {
        Text = "Enable",
        Default = false,
        Callback = function(v)
            if AvatarSettings.Selected == "Korblox" then
                AvatarSettings.Korblox = v
            elseif AvatarSettings.Selected == "Headless" then
                AvatarSettings.Headless = v
            end
            ApplySelected(LocalPlayer.Character)
        end,
    })

    LocalPlayer.CharacterAdded:Connect(function(char)
        task.wait(1)
        ApplySelected(char)
    end)
end

-- ============================================================
--  Defence タブ
-- ============================================================
do
    local cfg = {
        CounterMethod = "Kill", TargetedLimbCA = "All", AntiLagSens = 3,
        AGType = "Normal", GucciType = "CreatureBlobman",
        AntiInputType = "InstrumentGuitarBanjo",
        InputLgDelay = 0.05, AILTransparency = 0,
        NKOffset = 15, NKDelayMode = "Normal",
    }
    local togglesRef = {
        AntiGrab = false, AntiGrabRagdoll = false, AntiRagdoll = false,
        GucciAntiGrab = false, AntiBlobman = false, AntiInputLag = false,
        AntiExplosion = false, AntiBurn = false, AntiVoid = false,
        AntiKick = true, AntiKick2 = false,
        AntiSticky = false, AntiSnowball = false, AntiBanana = false,
        AntiPaint = false, AntiPoison = false,
        AntiLag = true, AntiLagV2 = true, AutoAntiLag = true,
        AntiInvis = false, AutoReset = true, LoopTP = false,
        DestroyVoid = true, WaterWalk = false, DeleteBarriers = false,
        OtherInvCollisions = false, CounterAttack = false,
    }
    local state = {
        WhoGrabbed = nil, KickFlags = 0, LastKickFlagTime = 0,
        States = { Owning = false, Spawning = false, ["Anti Grab"] = false },
        FailedToys = {},
    }
    local _t23 = {}
    local _v21 = nil

    local function locateRemoteRoot()
        local function isRR(a)
            return a and a:FindFirstChild("GrabEvents") and a:FindFirstChild("MenuToys") and a:FindFirstChild("CharacterEvents")
        end
        if isRR(ReplicatedStorage) then return ReplicatedStorage end
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if isRR(d) then return d end
        end
        return ReplicatedStorage
    end
    local function refreshRemotes()
        _v21 = locateRemoteRoot()
        local ge2 = ReplicatedStorage:FindFirstChild("GrabEvents")
        local mt2 = _v21 and _v21:FindFirstChild("MenuToys")
        local ce2 = _v21 and _v21:FindFirstChild("CharacterEvents")
        local pe2 = _v21 and _v21:FindFirstChild("PlayerEvents")
        _t23.sno = ge2 and ge2:FindFirstChild("SetNetworkOwner") or nil
        _t23.dgl = ge2 and ge2:FindFirstChild("DestroyGrabLine") or nil
        _t23.Struggle = ce2 and ce2:FindFirstChild("Struggle") or nil
        _t23.RagdollRemote = ce2 and ce2:FindFirstChild("RagdollRemote") or nil
        _t23.spe = pe2 and pe2:FindFirstChild("StickyPartEvent") or nil
        _t23.spawnEvent = mt2 and mt2:FindFirstChild("SpawnToyRemoteFunction") or nil
        _t23.destroyToyEvent = mt2 and mt2:FindFirstChild("DestroyToy") or nil
        return _v21
    end
    refreshRemotes()

    local function fireRemote(remote, ...)
        if not remote then return false, nil end
        local ok, r = pcall(function(...)
            if remote:IsA("RemoteFunction") then return remote:InvokeServer(...) end
            remote:FireServer(...)
            return true
        end, ...)
        return ok, r
    end
    local function charp(plr)
        local c = (plr or LocalPlayer).Character
        if not c then return nil, nil, nil end
        return c, c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"), c:FindFirstChildWhichIsA("Humanoid")
    end
    local function resetVel(p)
        if p and p:IsA("BasePart") then
            p.AssemblyLinearVelocity = Vector3.zero
            p.AssemblyAngularVelocity = Vector3.zero
        end
    end
    local function teleport(p, cf)
        if not p then return false end
        if typeof(p) == "Instance" and p:IsA("Model") then
            p = p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true)
        end
        if typeof(p) ~= "Instance" or not p:IsA("BasePart") then return false end
        local c = cf
        if typeof(cf) == "Vector3" then c = CFrame.new(cf) end
        if typeof(cf) == "Instance" then
            if cf:IsA("BasePart") then c = cf.CFrame
            elseif cf:IsA("Model") then c = cf:GetPivot() end
        end
        if not c then return false end
        p.CFrame = c
        resetVel(p)
        return true
    end
    local function FormatPlayer(plr)
        if typeof(plr) ~= "Instance" or not plr:IsA("Player") then return tostring(plr) end
        if plr == LocalPlayer then return "You" end
        if plr.DisplayName == plr.Name then return plr.Name end
        return string.format("%s (@%s)", plr.DisplayName, plr.Name)
    end
    local function grab(part, cf)
        local _, hrp, hum = charp()
        if not hrp or not hum or hum.Health == 0 then return end
        if not part or not part.Parent or not part:IsA("BasePart") then return end
        refreshRemotes()
        if not _t23.sno then return end
        cf = cf or hrp.CFrame
        if typeof(cf) ~= "CFrame" then return end
        local cframe = CFrame.new((cf * CFrame.new(0, 1.593, 0)).Position, part.Position)
        _t23.sno:FireServer(part, cframe)
    end
    local function dt(model)
        if typeof(model) ~= "Instance" or not model:IsA("Model") then return false end
        refreshRemotes()
        if not _t23.destroyToyEvent then return false end
        return fireRemote(_t23.destroyToyEvent, model) == true
    end
    local function st(name, cf)
        if type(name) ~= "string" or state.FailedToys[name] then return nil end
        local _, hrp = charp()
        if not hrp or state.States.Spawning then return nil end
        refreshRemotes()
        if not _t23.spawnEvent or not _t23.spawnEvent:IsA("RemoteFunction") then return nil end
        local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if not folder then return nil end
        state.States.Spawning = true
        local conn1 = nil
        local spawned = nil
        local ok = pcall(function()
            local cS = LocalPlayer:FindFirstChild("CanSpawnToy")
            if cS then
                while cS.Value == false do task.wait() if not hrp.Parent then return end end
            end
            local cframe = hrp.CFrame + Vector3.new(0, 15, 0)
            local n8 = CFrame.new((typeof(cf) == "CFrame" and cf or cframe).Position) + Vector3.new(0, 0, 20)
            local rop = Workspace:FindFirstChild("RotateOrientPart")
            local rot = rop and rop.Rotation or Vector3.zero
            conn1 = folder.ChildAdded:Connect(function(child)
                if child.Name == name then spawned = child conn1:Disconnect() conn1 = nil end
            end)
            task.spawn(function() fireRemote(_t23.spawnEvent, name, n8, rot) end)
            local now = tick()
            while not spawned and tick() - now < 1.3 do RunService.Heartbeat:Wait() end
        end)
