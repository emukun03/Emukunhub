    local function plusUpdateESP()
        if not Toggles.PlusCrossToggle or not Toggles.PlusCrossToggle.Value then return end
        plusGlobalRot = (plusGlobalRot + PL_ROT_SPEED) % 360
        plusPulseTime = plusPulseTime + PL_PULSE_SPEED
        local mid = (PL_PULSE_MIN + PL_PULSE_MAX) / 2
        local amp = (PL_PULSE_MAX - PL_PULSE_MIN) / 2
        local pulseFactor = mid + amp * math.sin(plusPulseTime)
        plusHue = (plusHue + PL_HUE_SPEED) % 1
        local targetColor = getHueColor(plusHue)
        local currentColor = lerpTo(lerpState.plus, targetColor)
        for _, player in pairs(Players:GetPlayers()) do
            if not plusObjects[player] then plusAddESP(player) end
            local data = plusObjects[player]
            if data then
                local container = data.container
                local char = player.Character
                if not char then
                    container.Visible = false
                else
                    local torsoPos = getTargetTorsoPos(player, char, PL_Y_OFFSET)
                    if not torsoPos then
                        container.Visible = false
                    else
                        local height = getPlayerHeight(char)
                        local dist = (Camera.CFrame.Position - torsoPos).Magnitude
                        local vec, onScreen = Camera:WorldToViewportPoint(torsoPos)
                        if onScreen then
                            local heightOnScreen = (height / dist) * (Camera.FieldOfView * 0.3)
                            local baseSize = heightOnScreen * PL_BASE_SCALE
                            if dist < PL_NEAR_DIST then baseSize = baseSize * PL_NEAR_DAMP end
                            if dist > PL_FAR_DIST then
                                local farFactor = math.clamp((dist - PL_FAR_DIST) / PL_FAR_RANGE, 0, 1)
                                baseSize = baseSize + (PL_FAR_BOOST * farFactor)
                            end
                            local finalSize = baseSize * pulseFactor
                            if finalSize < PL_SIZE_MIN then finalSize = PL_SIZE_MIN end
                            if finalSize > PL_SIZE_MAX then finalSize = PL_SIZE_MAX end
                            local scaleRatio = finalSize / 80
                            local armLen = PL_SIZE * scaleRatio
                            local thick  = PL_THICKNESS * scaleRatio
                            local outlineThick = (PL_THICKNESS + PL_OUTLINE * 2) * scaleRatio
                            local gap    = PL_GAP * scaleRatio
                            container.Size = UDim2.new(0, finalSize, 0, finalSize)
                            container.Position = UDim2.new(0, vec.X - finalSize / 2, 0, vec.Y - finalSize / 2)
                            container.Visible = true
                            data.arms.Top.outline.Size = UDim2.new(0, outlineThick, 0, armLen)
                            data.arms.Top.outline.Position = UDim2.new(0.5, 0, 0.5, -gap - armLen / 2)
                            data.arms.Top.inner.Size = UDim2.new(0, thick, 0, armLen)
                            data.arms.Top.inner.Position = UDim2.new(0.5, 0, 0.5, -gap - armLen / 2)
                            data.arms.Bottom.outline.Size = UDim2.new(0, outlineThick, 0, armLen)
                            data.arms.Bottom.outline.Position = UDim2.new(0.5, 0, 0.5, gap + armLen / 2)
                            data.arms.Bottom.inner.Size = UDim2.new(0, thick, 0, armLen)
                            data.arms.Bottom.inner.Position = UDim2.new(0.5, 0, 0.5, gap + armLen / 2)
                            data.arms.Left.outline.Size = UDim2.new(0, armLen, 0, outlineThick)
                            data.arms.Left.outline.Position = UDim2.new(0.5, -gap - armLen / 2, 0.5, 0)
                            data.arms.Left.inner.Size = UDim2.new(0, armLen, 0, thick)
                            data.arms.Left.inner.Position = UDim2.new(0.5, -gap - armLen / 2, 0.5, 0)
                            data.arms.Right.outline.Size = UDim2.new(0, armLen, 0, outlineThick)
                            data.arms.Right.outline.Position = UDim2.new(0.5, gap + armLen / 2, 0.5, 0)
                            data.arms.Right.inner.Size = UDim2.new(0, armLen, 0, thick)
                            data.arms.Right.inner.Position = UDim2.new(0.5, gap + armLen / 2, 0.5, 0)
                            container.Rotation = plusGlobalRot
                            for _, arm in pairs(data.arms) do
                                arm.inner.BackgroundColor3 = currentColor
                            end
                        else
                            container.Visible = false
                        end
                    end
                end
            end
        end
    end

