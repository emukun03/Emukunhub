    local PL_PULSE_MIN  = 0.60
    local PL_PULSE_MAX  = 1.20
    local PL_SIZE_MIN   = 6
    local PL_SIZE_MAX   = 100000
    local PL_BASE_SCALE = 95
    local PL_FAR_BOOST  = 200
    local PL_FAR_DIST   = 15
    local PL_FAR_RANGE  = 280
