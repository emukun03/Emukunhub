_G.EmukunHub = _G.EmukunHub or {}
_G.EmukunHub.Library = Library
_G.EmukunHub.Window  = Window
_G.EmukunHub.Tabs    = Tabs
_G.EmukunHub.Options = Options
_G.EmukunHub.Toggles = Toggles
_G.EmukunHub.Queue   = _G.EmukunHub.Queue or {}

_G.EmukunHub.AddFeature = function(name, icon, builder)
    table.insert(_G.EmukunHub.Queue, {
        name = name,
        icon = icon or "star",
        builder = builder,
    })
end

task.spawn(function()
    local processed = 0
    while true do
        task.wait(0.25)
        local q = _G.EmukunHub.Queue
        if q and #q > processed then
            for i = processed + 1, #q do
                local item = q[i]
                local ok, err = pcall(function()
                    local tab = Window:AddTab(item.name, item.icon)
                    if item.builder then
                        item.builder(tab)
                    end
                    notifyBig("Emukunhub", "機能を追加しました: " .. item.name, 4)
                end)
                if not ok then
                    warn("[Emukunhub] 機能追加失敗: " .. tostring(err))
                end
            end
            processed = #q
        end
    end
end)

