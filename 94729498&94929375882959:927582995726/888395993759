    local BP_PULSE_SPEED= 0.055
    local BP_PULSE_MIN  = 0.38
    local BP_PULSE_MAX  = 0.95
    local BP_SIZE_MIN   = 10
    local BP_SIZE_MAX   = 100000
    local BP_BASE_SCALE = 78
    local BP_FAR_BOOST  = 200
    local BP_FAR_DIST   = 15
    local BP_FAR_RANGE  = 280
    local BP_NEAR_DAMP  = 0.85
    local BP_NEAR_DIST  = 45
    local BP_COLOR      = Color3.fromRGB(170, 0, 255)
    local BP_CORNER_SIZE= 10
    local BP_THICKNESS  = 2

    local function ensureBoxPGui()
        if boxPGui and boxPGui.Parent then return boxPGui end
