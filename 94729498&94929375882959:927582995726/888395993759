    local DELAY_SECONDS = 0.35
    local HISTORY_MAX = 240
    local selfHistory = {}

    local HUE_CYAN = 0.50
    local HUE_PURPLE = 0.75

    local function getHueColor(phase)
        local s = math.sin(phase * math.pi * 2)
        local s3 = s * s * s
        local t = (s3 + 1) / 2
        local hue = HUE_CYAN + t * (HUE_PURPLE - HUE_CYAN)
        return Color3.fromHSV(hue, 1, 1)
    end

    local lerpState = {
        boxR = { current = nil },
        plus = { current = nil },
    }
    local LERP_SPEED = 0.15

    local function lerpTo(state, target)
        if not state.current then
            state.current = target
        else
            state.current = state.current:Lerp(target, LERP_SPEED)
        end
        return state.current
    end

    local function getTorsoCenter(char, yOffset)
        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local base
        if torso then base = torso.Position
        elseif hrp then base = hrp.Position + Vector3.new(0, 0.5, 0)
        else return nil end
        return base + Vector3.new(0, yOffset or 0, 0)
    end

    local function getPlayerHeight(char)
        local head = char:FindFirstChild("Head")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        local lowerTorso = char:FindFirstChild("LowerTorso")
        if not head or not hrp then return 4 end
        local topY = head.Position.Y + head.Size.Y / 2
        local bottomY
        if lowerTorso then bottomY = lowerTorso.Position.Y - lowerTorso.Size.Y / 2
        elseif torso then bottomY = torso.Position.Y - torso.Size.Y / 2
        else bottomY = hrp.Position.Y - 2 end
        return topY - bottomY
    end

    local function getDelayedSelfTorsoPos(yOffset)
        local char = LocalPlayer.Character
        if not char then return nil end
        local torsoPos = getTorsoCenter(char, yOffset)
        if not torsoPos then return nil end
        local now = os.clock()
        table.insert(selfHistory, { pos = torsoPos, t = now })
        while #selfHistory > 0 and (now - selfHistory[1].t) > (DELAY_SECONDS + 0.5) do
            table.remove(selfHistory, 1)
        end
        while #selfHistory > HISTORY_MAX do
            table.remove(selfHistory, 1)
        end
        local targetTime = now - DELAY_SECONDS
        for i = #selfHistory, 1, -1 do
            if selfHistory[i].t <= targetTime then
                return selfHistory[i].pos
            end
        end
        if #selfHistory > 0 then return selfHistory[1].pos end
        return torsoPos
    end

    local function getTargetTorsoPos(player, char, yOffset)
        if player == LocalPlayer then
            return getDelayedSelfTorsoPos(yOffset)
        end
        return getTorsoCenter(char, yOffset)
    end

