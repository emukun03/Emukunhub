        container.BackgroundTransparency = 1
        container.Size = UDim2.new(0, 80, 0, 80)
        container.Visible = false
        container.Parent = gui
        local thickness = BP_THICKNESS
        local cornerSize = BP_CORNER_SIZE
        local function createCornerLine(anchorPoint, position, size)
            local line = Instance.new("Frame")
            line.BackgroundColor3 = BP_COLOR
            line.BorderSizePixel = 0
            line.AnchorPoint = anchorPoint
            line.Position = position
            line.Size = size
            line.Parent = container
            return line
        end
        createCornerLine(Vector2.new(0, 0), UDim2.new(0, 0, 0, 0), UDim2.new(0, cornerSize, 0, thickness))
        createCornerLine(Vector2.new(0, 0), UDim2.new(0, 0, 0, 0), UDim2.new(0, thickness, 0, cornerSize))
        createCornerLine(Vector2.new(1, 0), UDim2.new(1, 0, 0, 0), UDim2.new(0, cornerSize, 0, thickness))
        createCornerLine(Vector2.new(1, 0), UDim2.new(1, 0, 0, 0), UDim2.new(0, thickness, 0, cornerSize))
        createCornerLine(Vector2.new(0, 1), UDim2.new(0, 0, 1, 0), UDim2.new(0, cornerSize, 0, thickness))
        createCornerLine(Vector2.new(0, 1), UDim2.new(0, 0, 1, 0), UDim2.new(0, thickness, 0, cornerSize))
        createCornerLine(Vector2.new(1, 1), UDim2.new(1, 0, 1, 0), UDim2.new(0, cornerSize, 0, thickness))
        createCornerLine(Vector2.new(1, 1), UDim2.new(1, 0, 1, 0), UDim2.new(0, thickness, 0, cornerSize))
        boxPObjects[p] = { container = container, lines = container:GetChildren(), player = p }
    end

    local function boxPRemoveESP(p)
        if boxPObjects[p] then
            if boxPObjects[p].container then boxPObjects[p].container:Destroy() end
            boxPObjects[p] = nil
        end
    end

    local function boxPRemoveAllESP()
        for p, data in pairs(boxPObjects) do
            if data and data.container then data.container:Destroy() end
        end
        boxPObjects = {}
    end

    local function boxPUpdateESP()
        if not Toggles.BoxPurpleToggle or not Toggles.BoxPurpleToggle.Value then return end
        local currentColor = BP_COLOR
        boxPGlobalRot = (boxPGlobalRot + BP_ROT_SPEED) % 360
        boxPPulseTime = boxPPulseTime + BP_PULSE_SPEED
        local mid = (BP_PULSE_MIN + BP_PULSE_MAX) / 2
        local amp = (BP_PULSE_MAX - BP_PULSE_MIN) / 2
        local pulseFactor = mid + amp * math.sin(boxPPulseTime)
        for _, player in pairs(Players:GetPlayers()) do
            if not boxPObjects[player] then boxPAddESP(player) end
            local data = boxPObjects[player]
            if data then
                local container = data.container
                local char = player.Character
                if not char then
                    container.Visible = false
                else
                    local torsoPos = getTargetTorsoPos(player, char, BP_Y_OFFSET)
                    if not torsoPos then
                        container.Visible = false
                    else
                        local height = getPlayerHeight(char)
                        local dist = (Camera.CFrame.Position - torsoPos).Magnitude
                        local vec, onScreen = Camera:WorldToViewportPoint(torsoPos)
                        if onScreen then
                            local heightOnScreen = (height / dist) * (Camera.FieldOfView * 0.3)
                            local baseSize = heightOnScreen * BP_BASE_SCALE
                            if dist < BP_NEAR_DIST then baseSize = baseSize * BP_NEAR_DAMP end
                            if dist > BP_FAR_DIST then
                                local farFactor = math.clamp((dist - BP_FAR_DIST) / BP_FAR_RANGE, 0, 1)
                                baseSize = baseSize + (BP_FAR_BOOST * farFactor)
                            end
                            local finalSize = baseSize * pulseFactor
                            if finalSize < BP_SIZE_MIN then finalSize = BP_SIZE_MIN end
                            if finalSize > BP_SIZE_MAX then finalSize = BP_SIZE_MAX end
                            container.Size = UDim2.new(0, finalSize, 0, finalSize)
                            container.Position = UDim2.new(0, vec.X - finalSize / 2, 0, vec.Y - finalSize / 2)
                            container.Visible = true
                            container.Rotation = boxPGlobalRot
                            for _, line in ipairs(data.lines) do
                                if line:IsA("Frame") then line.BackgroundColor3 = currentColor end
                            end
                        else
                            container.Visible = false
                        end
                    end
                end
            end
        end
    end

    local function boxPSetState(state)
        if state then
            ensureBoxPGui()
            boxPRemoveAllESP()
            boxPGlobalRot = 0
            for _, p in pairs(Players:GetPlayers()) do boxPAddESP(p) end
            if boxPUpdateConn then boxPUpdateConn:Disconnect() end
            boxPUpdateConn = RunService.RenderStepped:Connect(boxPUpdateESP)
        else
            if boxPUpdateConn then boxPUpdateConn:Disconnect(); boxPUpdateConn = nil end
            boxPRemoveAllESP()
            boxPPulseTime = 0
            boxPGlobalRot = 0
        end
    end

