                    for _, part in pairs(model:GetDescendants()) do
                        if part:FindFirstChild("ShurikenESP_Sub") then part.ShurikenESP_Sub:Destroy() end
                    end
                end
                shurikenEspObjects = {}
                if shurikenHighlightConn then shurikenHighlightConn:Disconnect() shurikenHighlightConn = nil end
            end
        end

