local function notify(_, _, _) end

local function notifyBig(title, bigDesc, time)
    Library:Notify({
        Title = title or "Notification",
        Description = bigDesc or "",
        Time = time or 5,
    })
    task.defer(function()
        local Main = Library.ScreenGui and Library.ScreenGui:FindFirstChild("Main")
        if not Main then return end
        local newest, newestY = nil, math.huge
        for _, v in Main:GetDescendants() do
            if v:IsA("TextLabel") and v.Text == bigDesc then
                if v.AbsolutePosition.Y < newestY then
                    newest, newestY = v, v.AbsolutePosition.Y
                end
            end
        end
        if newest then newest.TextSize = 22 end
    end)
end

local function notifyPlayerLeft(display, name)
    local title = "Player Left"
    local desc  = string.format("%s (@%s)\nKicked %s from the Server", display, name, display)

    Library:Notify({
        Title       = title,
        Description = desc,
        Time        = 6,
    })

    task.defer(function()
        local Main = Library.ScreenGui and Library.ScreenGui:FindFirstChild("Main")
        if not Main then return end
        local titleLabel, descLabel
        local newestY = math.huge
        for _, v in Main:GetDescendants() do
            if v:IsA("TextLabel") then
                local t = v.Text or ""
                if t == "Player Left" then
                    if v.AbsolutePosition.Y < newestY then
                        newestY = v.AbsolutePosition.Y
                        titleLabel = v
                    end
                elseif t:find(display, 1, true) or t:find(name, 1, true) then
                    descLabel = v
                end
            end
        end
        if titleLabel then titleLabel.TextSize = 16 end
        if descLabel then descLabel.TextSize = 20 end
    end)
end

