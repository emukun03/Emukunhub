do
    local spamKickEnabled = false
    local spamKickMainTask = nil
    local spamKickBodyPosition = nil
    local spamKickBodyGyro = nil
    local spamKickSavedPosition = nil
    local spamKickDragging = false
    local spamKickGrabStartTime = 0
    local spamKickNoclipConn = nil
    local GE = ReplicatedStorage:WaitForChild("GrabEvents", 10)
    local sNO = GE and GE:WaitForChild("SetNetworkOwner", 5)
    local dGL = GE and GE:WaitForChild("DestroyGrabLine", 5)
    local function SetNoclip(e)
        if spamKickNoclipConn then spamKickNoclipConn:Disconnect() spamKickNoclipConn = nil end
        if e then
            spamKickNoclipConn = RunService.Stepped:Connect(function()
                if LocalPlayer.Character then
                    for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end)
        end
    end
    local function CreateBodies(tr, pos)
        if spamKickBodyPosition then spamKickBodyPosition:Destroy() spamKickBodyPosition = nil end
        if spamKickBodyGyro then spamKickBodyGyro:Destroy() spamKickBodyGyro = nil end
        spamKickBodyPosition = Instance.new("BodyPosition")
        spamKickBodyPosition.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        spamKickBodyPosition.P = 100000 spamKickBodyPosition.D = 1000
        spamKickBodyPosition.Position = pos
        spamKickBodyPosition.Parent = tr
        spamKickBodyGyro = Instance.new("BodyGyro")
        spamKickBodyGyro.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        spamKickBodyGyro.P = 100000 spamKickBodyGyro.D = 1000
        spamKickBodyGyro.CFrame = CFrame.new(pos)
        spamKickBodyGyro.Parent = tr
    end
    local function CleanupBodies()
        if spamKickBodyPosition then spamKickBodyPosition:Destroy() spamKickBodyPosition = nil end
        if spamKickBodyGyro then spamKickBodyGyro:Destroy() spamKickBodyGyro = nil end
    end
    local function StopSpam()
        spamKickEnabled = false
        if spamKickMainTask then task.cancel(spamKickMainTask) spamKickMainTask = nil end
        CleanupBodies()
        SetNoclip(false)
    end
    local function StartSpam()
        if spamKickEnabled then return end
        local tn = SharedTarget.Username
        if not tn or tn == "" then Toggles.SpamGrabKickToggle:SetValue(false) return end
        local tp = SharedTarget.Player
        if not tp then Toggles.SpamGrabKickToggle:SetValue(false) return end
        spamKickEnabled = true
        SetNoclip(true)
        spamKickMainTask = task.spawn(function()
            local _, myRoot = getCharInfo()
            if not myRoot then StopSpam() return end
            spamKickSavedPosition = myRoot.CFrame
            while spamKickEnabled do
                local cur = Players:FindFirstChild(tp.Name)
                if not cur then CleanupBodies() task.wait() continue end
                local _, mr = getCharInfo()
                local tChar = cur.Character
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChild("Humanoid")
                if tRoot and tHum and tHum.Health > 0 and mr then
                    if not spamKickDragging then
                        mr.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                        CleanupBodies()
                        if sNO then sNO:FireServer(tRoot, tRoot.CFrame) end
                        if sNO then sNO:FireServer(tRoot, tRoot.CFrame) end
                        if dGL then dGL:FireServer(tRoot) end
                        mr.AssemblyLinearVelocity = Vector3.zero
                        mr.AssemblyAngularVelocity = Vector3.zero
                        if spamKickGrabStartTime == 0 then spamKickGrabStartTime = tick() end
                        if tick() - spamKickGrabStartTime > 0.35 then
