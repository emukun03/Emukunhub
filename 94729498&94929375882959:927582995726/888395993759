-- Blob Kill
do
    local currentBlobman = nil
    local function GetSeatedBlobman()
        local char = LocalPlayer.Character
        if not char then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return nil end
        local seat = hum.SeatPart
        if not seat or not seat:IsA("VehicleSeat") then return nil end
        local obj = seat
        while obj do
            if obj:IsA("Model") and obj.Name == "CreatureBlobman" then return obj end
            obj = obj.Parent
        end
        return nil
    end
    local function SpawnBlobman()
        local s = GetSeatedBlobman()
        if s then currentBlobman = s return s end
        if currentBlobman and currentBlobman.Parent then
            local pos
            if currentBlobman.PrimaryPart then pos = currentBlobman.PrimaryPart.Position
            else
                local p = currentBlobman:FindFirstChildWhichIsA("BasePart")
                if p then pos = p.Position end
            end
            local char = LocalPlayer.Character
            local rp = char and char:FindFirstChild("HumanoidRootPart")
            local lp = rp and rp.Position
            if pos and lp and (pos - lp).Magnitude < 500 then
                local seat = currentBlobman:FindFirstChild("VehicleSeat")
                if seat then
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then seat:Sit(hum) task.wait(0.1) end
                end
                return currentBlobman
            else
                pcall(function() currentBlobman:Destroy() end)
                currentBlobman = nil
            end
        end
        local char = LocalPlayer.Character
        if not char then return nil end
        local rp = char:FindFirstChild("HumanoidRootPart")
        if not rp then return nil end
        local sp = rp.CFrame * CFrame.new(0, 0, -5)
        pcall(function()
            ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer("CreatureBlobman", sp, Vector3.new(0, 127, 0))
        end)
        local folderName = LocalPlayer.Name .. "SpawnedInToys"
        local blobman = nil
        local st = tick()
        repeat
            local folder = Workspace:FindFirstChild(folderName)
            if folder then blobman = folder:FindFirstChild("CreatureBlobman") end
            if blobman then break end
            task.wait()
        until tick() - st > 3
        if not blobman then return nil end
        currentBlobman = blobman
        local seat = blobman:FindFirstChild("VehicleSeat")
        if seat then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then seat:Sit(hum) task.wait(0.1) end
        end
        return blobman
    end
    local function BGR(bm, tr)
        if not bm or not tr then return end
        pcall(function()
            local s = bm:FindFirstChild("BlobmanSeatAndOwnerScript")
            if s then
                s.CreatureGrab:FireServer(bm.LeftDetector, tr, bm.LeftDetector.LeftWeld)
                s.CreatureRelease:FireServer(bm.LeftDetector.LeftWeld)
            end
        end)
    end
    local function Process(tp)
        if not tp or not tp.Character then return false end
        local hum = tp.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local tRoot = tp.Character:FindFirstChild("HumanoidRootPart")
        if not tRoot then return false end
        local lc = LocalPlayer.Character
        if not lc then return false end
        local myRoot = lc:FindFirstChild("HumanoidRootPart")
        if not myRoot then return false end
        local bm = GetSeatedBlobman() or SpawnBlobman()
        if not bm then return false end
        local ocf, ov, oa = myRoot.CFrame, myRoot.AssemblyLinearVelocity, myRoot.AssemblyAngularVelocity
        pcall(function()
            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, -3)
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
        end)
        task.wait(0.05)
        pcall(function() BGR(bm, tRoot) end)
        task.wait(0.02)
        pcall(function()
            hum.BreakJointsOnDeath = false
            hum:ChangeState(Enum.HumanoidStateType.Dead)
        end)
        pcall(function() BGR(bm, tRoot) end)
        if myRoot and myRoot.Parent then
            myRoot.CFrame = ocf
            myRoot.AssemblyLinearVelocity = ov or Vector3.zero
            myRoot.AssemblyAngularVelocity = oa or Vector3.zero
        end
        return true
    end
    KillGroup:AddToggle("BlobKillToggle", { Text = "Blob Kill", Default = false,
        Callback = function(on)
            blobKillEnabled = on
            if on then
                local target = SharedTarget.Player
                if not target then Toggles.BlobKillToggle:SetValue(false) return end
                task.spawn(function()
                    while blobKillEnabled do
                        if not target or not target.Parent or not target.Character then
                            blobKillEnabled = false Toggles.BlobKillToggle:SetValue(false) break
                        end
                        pcall(Process, target)
                        task.wait(0.1)
                    end
                end)
            else blobKillEnabled = false end
        end })
end

-- Ragdoll Kill / Pencil Kill
do
    local function getFolder() return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys") end
    local function destroyPencils()
        local f = getFolder()
        if not f then return end
        local dt = ReplicatedStorage:FindFirstChild("MenuToys") and ReplicatedStorage.MenuToys:FindFirstChild("DestroyToy")
        if not dt then return end
        for _, c in pairs(f:GetChildren()) do
            if c.Name == "ToolPencil" then pcall(function() dt:FireServer(c) end) end
        end
    end
    local function countPencils()
        local f = getFolder()
        if not f then return 0 end
        local n = 0
        for _, c in pairs(f:GetChildren()) do
            if c.Name == "ToolPencil" then n = n + 1 end
        end
        return n
    end
    local function isWelded()
        local f = getFolder()
        if not f then return false end
        local t = SharedTarget.Player
        if not t or not t.Character then return false end
        local th = t.Character:FindFirstChild("Head")
        if not th then return false end
        for _, c in pairs(f:GetChildren()) do
            if c.Name == "ToolPencil" then
                local sp = c:FindFirstChild("StickyPart")
                if sp then
                    local w = sp:FindFirstChild("StickyWeld")
                    if w and w.Part1 == th then return true end
                end
            end
        end
        return false
    end
    local function spawnPencil()
        local _, myRoot = getCharInfo()
        if not myRoot then return nil end
        local sp = myRoot.CFrame * CFrame.new(0, 14, 20)
        local MT = ReplicatedStorage:FindFirstChild("MenuToys")
        if not MT then return nil end
        local sr = MT:FindFirstChild("SpawnToyRemoteFunction")
        if not sr then return nil end
        local spawned = nil
        local folder = getFolder()
        if not folder then return nil end
        local conn = folder.ChildAdded:Connect(function(child)
            if child.Name == "ToolPencil" then spawned = child conn:Disconnect() end
        end)
        task.spawn(function() pcall(function() sr:InvokeServer("ToolPencil", sp, Vector3.zero) end) end)
        local st = tick()
        repeat task.wait(0.05) until spawned or (tick() - st) > 3
        if conn then pcall(function() conn:Disconnect() end) end
        return spawned
    end
    local function setNO(part)
        if not part then return end
        local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
        if not GE then return end
        local sN = GE:FindFirstChild("SetNetworkOwner")
        if not sN then return end
        for i = 1, 5 do pcall(function() sN:FireServer(part, part.CFrame) end) end
    end
    local function doSticky()
        local target = SharedTarget.Player
        if not target then return false end
        if not target.Character then return false end
        local th = target.Character:FindFirstChild("Head")
        if not th then return false end
        destroyPencils()
        task.wait(0.05)
        local p = spawnPencil()
        if not p then return false end
        local sP = p:FindFirstChild("SoundPart")
        local stP = p:FindFirstChild("StickyPart")
        if sP then setNO(sP) end
        task.wait(0.05)
        if stP then
            local se = ReplicatedStorage:FindFirstChild("PlayerEvents") and ReplicatedStorage.PlayerEvents:FindFirstChild("StickyPartEvent")
            if se then
                pcall(function()
                    se:FireServer(stP, th, CFrame.new(0, 0/0, 0))
                    se:FireServer(stP, th, CFrame.new(0, 0/0, 0))
                end)
                task.wait(0.5)
                if not isWelded() then destroyPencils() task.wait(0.05) doSticky() end
                return true
            end
        end
        return false
    end
    local rkActive = false
    local rkMonitor = nil
    local function RkMonitor()
        while rkActive do
            local n = countPencils()
            if n == 0 then doSticky()
            elseif n >= 2 then destroyPencils() task.wait(0.05) doSticky()
            elseif n == 1 then
                if not isWelded() then destroyPencils() task.wait(0.05) doSticky() end
            end
            task.wait(0.1)
        end
    end
    KillGroup:AddToggle("RagdollKillToggle", { Text = "Ragdoll Kill", Default = false,
        Callback = function(v)
            if v then
                if not SharedTarget.Player then Toggles.RagdollKillToggle:SetValue(false) return end
                rkActive = true
                ragdollKillEnabled = true
                doSticky()
                SharedTarget.Player.CharacterAdded:Connect(function()
                    if rkActive then doSticky() end
                end)
                rkMonitor = task.spawn(RkMonitor)
            else
                rkActive = false
                ragdollKillEnabled = false
                if rkMonitor then task.cancel(rkMonitor) rkMonitor = nil end
                destroyPencils()
            end
        end })

    local pkActive = false
    local pkMonitor = nil
    local function PkMonitor()
        while pkActive do
            local n = countPencils()
            if n == 0 then doSticky()
            elseif n >= 2 then destroyPencils() task.wait(0.05) doSticky()
            elseif n == 1 then
                if not isWelded() then destroyPencils() task.wait(0.05) doSticky() end
            end
            task.wait(0.1)
        end
    end
    KillGroup:AddToggle("PencilKillToggle", { Text = "Pencil Kill", Default = false,
        Callback = function(v)
            if v then
                if not SharedTarget.Player then Toggles.PencilKillToggle:SetValue(false) return end
                pkActive = true
                doSticky()
                SharedTarget.Player.CharacterAdded:Connect(function()
                    if pkActive then doSticky() end
                end)
                pkMonitor = task.spawn(PkMonitor)
            else
                pkActive = false
                if pkMonitor then task.cancel(pkMonitor) pkMonitor = nil end
                destroyPencils()
            end
        end })
end

-- Loop Banana Ragdoll
do
    local isLooping = false
    local loopConn = nil
    local monitorConn = nil
    local curBanana = nil
    local isDead = false
    local function getFolder() return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys") end
    local function setNO(part)
        if not part then return end
        local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
        if not GE then return end
        local sN = GE:FindFirstChild("SetNetworkOwner")
        if not sN then return end
        pcall(function() sN:FireServer(part, part.CFrame) end)
    end
    local function destroyGL(part)
        if not part then return end
        local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
        if not GE then return end
        local dL = GE:FindFirstChild("DestroyGrabLine")
        if not dL then return end
        pcall(function() dL:FireServer(part) end)
    end
    local function destroyBanana(b)
        if not b then return end
        local MT = ReplicatedStorage:FindFirstChild("MenuToys")
        if not MT then return end
        local dT = MT:FindFirstChild("DestroyToy")
        if not dT then return end
        pcall(function() dT:FireServer(b) end)
    end
    local function spawnBanana()
        local _, myRoot = getCharInfo()
        if not myRoot then return nil end
        local sp = myRoot.CFrame * CFrame.new(0, 14, 20)
        local MT = ReplicatedStorage:FindFirstChild("MenuToys")
        if not MT then return nil end
        local sr = MT:FindFirstChild("SpawnToyRemoteFunction")
        if not sr then return nil end
        local spawned = nil
        local folder = getFolder()
        if not folder then return nil end
        local conn = folder.ChildAdded:Connect(function(child)
            if child.Name == "FoodBanana" then spawned = child conn:Disconnect() end
        end)
        task.spawn(function() pcall(function() sr:InvokeServer("FoodBanana", sp, Vector3.zero) end) end)
        local st = tick()
        repeat task.wait(0.05) until spawned or (tick() - st) > 3
        if conn then pcall(function() conn:Disconnect() end) end
        return spawned
    end
    local function holdBanana(b)
        if not b then return end
        local hp = b:FindFirstChild("HoldPart")
        if not hp then return end
        local hr = hp:FindFirstChild("HoldItemRemoteFunction")
        if not hr then return end
        local c = LocalPlayer.Character
        if not c then return end
        for i = 1, 5 do
            if not b or not b.Parent then break end
            local ok = pcall(function() return hr:InvokeServer(b, c) end)
            if ok then return true end
            task.wait(0.05)
        end
        return false
    end
    local function useBanana(b)
        if not b then return end
        local ue = ReplicatedStorage:FindFirstChild("HoldEvents") and ReplicatedStorage.HoldEvents:FindFirstChild("Use")
        if not ue then return end
        pcall(function() ue:FireServer(b) end)
    end
    local function dropBanana(b)
        if not b then return end
        local hp = b:FindFirstChild("HoldPart")
        if not hp then return end
        local dr = hp:FindFirstChild("DropItemRemoteFunction")
        if not dr then return end
        local _, myRoot = getCharInfo()
        if not myRoot then return end
        local dp = myRoot.CFrame * CFrame.new(0, 15, 0)
        pcall(function() dr:InvokeServer(b, dp, dp) end)
    end
    local function getLeg()
        local target = SharedTarget.Player
        if not target then return nil end
        if not target.Character then return nil end
        return target.Character:FindFirstChild("Left Leg")
    end
    local function getHealth()
        local target = SharedTarget.Player
        if not target then return 0 end
        if not target.Character then return 0 end
        local h = target.Character:FindFirstChildOfClass("Humanoid")
        if not h then return 0 end
        return h.Health
    end
    local function cycle()
        if not SharedTarget.Player then return false end
        local b = spawnBanana()
        if not b then return false end
        holdBanana(b) task.wait(0.05) holdBanana(b) task.wait(0.05)
        task.wait(0.5)
        useBanana(b)
        task.wait(2.3)
        dropBanana(b) task.wait(0.05) dropBanana(b)
        task.wait(0.3)
        return b
    end
    local function restart(b)
        if loopConn then loopConn:Disconnect() loopConn = nil end
        curBanana = b
        local hb = b:FindFirstChild("HitboxPart")
        if not hb then return end
        loopConn = RunService.Heartbeat:Connect(function()
            if not isLooping then return end
            if not curBanana or not curBanana.Parent then return end
            local folder = getFolder()
            local exists = false
            if folder then
                for _, c in pairs(folder:GetChildren()) do
                    if c.Name == "FoodBanana" then
                        exists = true
                        curBanana = c
                        hb = c:FindFirstChild("HitboxPart")
                        break
                    end
                end
            end
            if not exists or not hb then
                loopConn:Disconnect() loopConn = nil curBanana = nil
                return
            end
            local _, myRoot = getCharInfo()
            if not myRoot then return end
            local tp, tcf
            local h = getHealth()
            if h <= 0 then
                isDead = true
                tp = myRoot.CFrame * CFrame.new(0, 7, 0)
                tcf = CFrame.new(tp.Position)
            else
                isDead = false
                local l = getLeg()
                if l then tp = l.CFrame * CFrame.new(0, 0.5, 0) tcf = l.CFrame
                else tp = myRoot.CFrame * CFrame.new(0, 7, 0) tcf = CFrame.new(tp.Position) end
            end
            setNO(hb)
            destroyGL(hb)
            local bp = hb:FindFirstChild("BodyPosition")
            if bp then bp.Position = tp.Position
            else
                bp = Instance.new("BodyPosition")
                bp.P = 10000 bp.D = 100
                bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                bp.Position = tp.Position
                bp.Parent = hb
            end
            local bg = hb:FindFirstChild("BodyGyro")
            if bg then bg.CFrame = tcf
            else
                bg = Instance.new("BodyGyro")
                bg.P = 10000 bg.D = 100
                bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                bg.CFrame = tcf
                bg.Parent = hb
            end
        end)
    end
    local function start()
        if isLooping then return end
        if not SharedTarget.Player then return end
        isLooping = true
        isDead = false
        local b = cycle()
        if b then restart(b) end
        monitorConn = RunService.Heartbeat:Connect(function()
            if not isLooping then return end
            local folder = getFolder()
            local exists = false
            if folder then
                for _, c in pairs(folder:GetChildren()) do
                    if c.Name == "FoodBanana" then exists = true break end
                end
            end
            if not exists then
                if loopConn then loopConn:Disconnect() loopConn = nil end
                task.wait(0.05)
                local nb = cycle()
                if nb then restart(nb) end
            end
        end)
    end
    local function stop()
        isLooping = false
        if loopConn then loopConn:Disconnect() loopConn = nil end
        if monitorConn then monitorConn:Disconnect() monitorConn = nil end
        if curBanana then
            destroyBanana(curBanana)
            local hb = curBanana:FindFirstChild("HitboxPart")
            if hb then
                local bp = hb:FindFirstChild("BodyPosition")
                if bp then bp:Destroy() end
                local bg = hb:FindFirstChild("BodyGyro")
                if bg then bg:Destroy() end
            end
