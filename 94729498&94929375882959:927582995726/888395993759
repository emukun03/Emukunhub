end)

local function __rejoinAndExecute()
    if not _G.EmukunHub_AutoExecute then return end

    pcall(function()
        if queue_on_teleport and __SCRIPT_SOURCE then
            queue_on_teleport(__SCRIPT_SOURCE)
        end
    end)

    pcall(function()
        if syn and syn.queue_on_teleport and __SCRIPT_SOURCE then
            syn.queue_on_teleport(__SCRIPT_SOURCE)
        end
    end)
end

Players.PlayerRemoving:Connect(function(plr)
    if plr == LocalPlayer then
        __rejoinAndExecute()
    end
end)

