    local function boxRUpdateESP()
        if not Toggles.BoxRainbowToggle or not Toggles.BoxRainbowToggle.Value then return end
        boxRGlobalRot = (boxRGlobalRot + BR_ROT_SPEED) % 360
        boxRPulseTime = boxRPulseTime + BR_PULSE_SPEED
        local mid = (BR_PULSE_MIN + BR_PULSE_MAX) / 2
        local amp = (BR_PULSE_MAX - BR_PULSE_MIN) / 2
        local pulseFactor = mid + amp * math.sin(boxRPulseTime)
        boxRHue = (boxRHue + BR_HUE_SPEED) % 1
        local targetColor = getHueColor(boxRHue)
        local currentColor = lerpTo(lerpState.boxR, targetColor)
        for _, player in pairs(Players:GetPlayers()) do
            if not boxRObjects[player] then boxRAddESP(player) end
            local data = boxRObjects[player]
            if data then
                local container = data.container
                local char = player.Character
                if not char then
                    container.Visible = false
                else
                    local torsoPos = getTargetTorsoPos(player, char, BR_Y_OFFSET)
                    if not torsoPos then
                        container.Visible = false
                    else
                        local height = getPlayerHeight(char)
                        local dist = (Camera.CFrame.Position - torsoPos).Magnitude
                        local vec, onScreen = Camera:WorldToViewportPoint(torsoPos)
                        if onScreen then
                            local heightOnScreen = (height / dist) * (Camera.FieldOfView * 0.3)
                            local baseSize = heightOnScreen * BR_BASE_SCALE
                            if dist < BR_NEAR_DIST then baseSize = baseSize * BR_NEAR_DAMP end
                            if dist > BR_FAR_DIST then
                                local farFactor = math.clamp((dist - BR_FAR_DIST) / BR_FAR_RANGE, 0, 1)
                                baseSize = baseSize + (BR_FAR_BOOST * farFactor)
                            end
                            local finalSize = baseSize * pulseFactor
                            if finalSize < BR_SIZE_MIN then finalSize = BR_SIZE_MIN end
                            if finalSize > BR_SIZE_MAX then finalSize = BR_SIZE_MAX end
                            container.Size = UDim2.new(0, finalSize, 0, finalSize)
                            container.Position = UDim2.new(0, vec.X - finalSize / 2, 0, vec.Y - finalSize / 2)
                            container.Visible = true
                            container.Rotation = boxRGlobalRot
                            for _, line in ipairs(data.lines) do
                                if line:IsA("Frame") then line.BackgroundColor3 = currentColor end
                            end
                        else
                            container.Visible = false
                        end
                    end
                end
            end
        end
    end

