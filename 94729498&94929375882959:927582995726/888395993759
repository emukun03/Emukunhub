                    end)
                end)
                if not folder then folder = Workspace:WaitForChild(fn, 5) end
                if folder then blob = folder:WaitForChild("CreatureBlobman", 5) end
            end
            if blob then
                local seat = blob:WaitForChild("VehicleSeat", 5)
                if seat then
                    local t = tick()
                    repeat
                        if not hum.SeatPart then
                            hrp.CFrame = seat.CFrame + Vector3.new(0, 1, 0)
                            hrp.Velocity = Vector3.zero
                            seat:Sit(hum)
                        end
                        RunService.Heartbeat:Wait()
                    until hum.SeatPart == seat or tick() - t > 1.5 or not blobKickAutoSit
                end
            end
            task.wait(0.5)
        end
    end
